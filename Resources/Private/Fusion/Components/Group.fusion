##
# One publish, or what one person did in live directly in the same minute: who, how much, when; its entries grouped by
# page below, the rest folded after the first few (Module.js)
#
prototype(Devclaim.NeosActivity:Group) < prototype(Neos.Fusion:Component) {
    group = null

    renderer = afx`
        <section class="activity__group" data-group>
            <header class="activity__group-head">
                <span class={['activity__avatar', 'activity__avatar--large', props.group.userId == 'system' ? 'activity__avatar--system' : null]} aria-hidden="true">{props.group.initials}</span>
                <span class="activity__group-title">
                    <span class="activity__who">{props.group.user || ''}</span>
                    <span class="activity__what">{props.group.summary}</span>
                </span>
                <time class="activity__group-time">{props.group.time}</time>
            </header>
            <div class="activity__documents">
                <Neos.Fusion:Loop items={props.group.documents} itemName="document">
                    <section class="activity__document" data-document hidden={document.folded ? true : null} data-folded={document.folded ? 'true' : null}>
                        <header class="activity__document-head">
                            <i class="fas fa-globe activity__document-icon" aria-hidden="true"></i>
                            <span class="activity__document-text">
                                <span class="activity__document-title">{document.label}</span>
                                <span class="activity__document-sub">{document.summary}</span>
                            </span>
                        </header>
                        <div class="activity__document-entries">
                            <Neos.Fusion:Loop items={document.entries} itemName="entry">
                                <Devclaim.NeosActivity:Entry entry={entry} folded={entry.folded}/>
                            </Neos.Fusion:Loop>
                        </div>
                    </section>
                </Neos.Fusion:Loop>
            </div>
            <button type="button" class="activity__more" data-unfold @if.shown={props.group.hidden > 0}>
                {I18n.translate('group.more', null, [props.group.hidden], 'Main', 'Devclaim.NeosActivity')}
            </button>
        </section>
    `
}
